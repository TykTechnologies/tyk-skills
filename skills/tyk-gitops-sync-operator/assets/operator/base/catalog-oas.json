{
  "openapi": "3.0.3",
  "info": {"title": "Catalog", "version": "1.0.0"},
  "paths": {"/items": {"get": {"operationId": "listItems", "responses": {"200": {"description": "ok"}}}}},
  "components": {"securitySchemes": {"apiKey": {"type": "apiKey", "in": "header", "name": "Authorization"}}},
  "security": [{"apiKey": []}],
  "x-tyk-api-gateway": {
    "info": {"name": "Catalog", "state": {"active": true}},
