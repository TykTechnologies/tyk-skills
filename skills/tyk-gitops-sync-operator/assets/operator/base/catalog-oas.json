      "listenPath": {"value": "/catalog/", "strip": true},
      "authentication": {"enabled": true, "securitySchemes": {"apiKey": {"enabled": true}}}
    },
    "upstream": {"url": "kv://env/ORDERS_UPSTREAM"}
  }
}
