TYK_LICENSE_KEY=
TYK_PORTAL_LICENSE=
DASHBOARD_VERSION=v5.16.0
GATEWAY_VERSION=v5.16.0
PUMP_VERSION=v1.18.0
PORTAL_VERSION=v1.20.1
OPERATOR_VERSION=v1.6.0
TYK_SYNC_VERSION=v2.3.0
ADMIN_SECRET=
NODE_SECRET=
POSTGRES_PASSWORD=
# Root token of the Vault dev server (vault module only); the generator mints it in .env.
VAULT_TOKEN=
# Host address every published port binds to. 127.0.0.1 keeps the demo on this machine.
# 0.0.0.0 presents it to other machines, and with it the local identity fixture, which signs
# any claims it is sent: every peer could mint tokens the demo's JWT APIs accept. Opt in only
# on a trusted network, for the session, then set it back.
BIND_ADDRESS=127.0.0.1
COMPOSE_PROFILES=__COMPOSE_PROFILES__
DASHBOARD_PORT=__DASHBOARD_PORT__
PORTAL_PORT=__PORTAL_PORT__
GATEWAY_PORT=__GATEWAY_PORT__
UPSTREAM_PORT=__UPSTREAM_PORT__
IDENTITY_PORT=__IDENTITY_PORT__
WEBSOCKET_PORT=__WEBSOCKET_PORT__
GRAPHQL_PORT=__GRAPHQL_PORT__
KAFKA_PORT=__KAFKA_PORT__
OTEL_GRPC_PORT=__OTEL_GRPC_PORT__
OTEL_HTTP_PORT=__OTEL_HTTP_PORT__
PROMETHEUS_PORT=__PROMETHEUS_PORT__
TEMPO_PORT=__TEMPO_PORT__
MCP_MOCK_PORT=__MCP_MOCK_PORT__
MCP_INSPECTOR_PORT=__MCP_INSPECTOR_PORT__
MCP_INSPECTOR_PROXY_PORT=__MCP_INSPECTOR_PROXY_PORT__
GATEWAY_EXTERNAL_PORT=__GATEWAY_EXTERNAL_PORT__
VAULT_PORT=__VAULT_PORT__
UPSTREAM_MTLS_PORT=__UPSTREAM_MTLS_PORT__
