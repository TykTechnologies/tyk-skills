{
  "name": "Neutral native Go plugin API",
  "api_id": "neutral-native-go-plugin",
  "org_id": "default",
  "use_keyless": false,
  "auth": {
    "auth_header_name": "Authorization"
  },
  "definition": {
    "location": "header",
    "key": "version"
  },
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true
      }
    }
  },
  "proxy": {
    "listen_path": "/native-plugin/",
    "target_url": "http://demo-upstream:8080",
    "strip_listen_path": true
  },
  "custom_middleware": {
    "driver": "goplugin",
    "post": [
      {
        "name": "PostEnrich",
        "path": "/opt/tyk-gateway/plugins/go/build/post_enrich.so",
        "require_session": true,
        "raw_body_only": false
      }
    ]
  },
  "active": true
}
