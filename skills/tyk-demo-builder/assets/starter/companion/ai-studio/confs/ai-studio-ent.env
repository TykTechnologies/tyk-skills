# Tyk AI Studio control plane, Enterprise edition (AI Studio 2.3).
#
# Shared secrets deliberately live in ../secret.env, which is gitignored.
# Do not add GRPC_AUTH_TOKEN, MICROGATEWAY_ENCRYPTION_KEY, TYK_AI_SECRET_KEY or
# METRICS_AUTH_TOKEN here: later env_file entries win, so a value here would
# silently override the minted one and break the edge handshake.

ALLOW_REGISTRATIONS=true
SITE_URL=http://localhost:__AISTUDIO_ADMIN_PORT__
FROM_EMAIL=noreply@__SLUG__.invalid
DEBUG_HTTP=false
DEBUG_HTTP_PROXY=false
LOG_LEVEL=info

# SQLite keeps the companion stack to two Tyk containers plus the stubs. The
# path is absolute, so it resolves regardless of the image WORKDIR; the compose
# file bind-mounts ./data/ai-studio there.
DATABASE_TYPE=sqlite
DATABASE_URL=file:/app/data/db/ai-studio-ent.db

ECHO_CONVERSATION=true

# Anonymous usage statistics are sent hourly to telemetry.tyk.technology unless
# this is false (https://tyk.io/docs/ai-management/ai-studio/telemetry). A demo
# on a workstation has no reason to send them; the control plane logs
# "Telemetry is disabled" at startup.
TELEMETRY_ENABLED=false
DEFAULT_SIGNUP_MODE="both"
# A new App created WITHOUT a budget gets this (monthly_budget null = no limit,
# 0 = zero spend). configure-ai-studio.sh sets both demo Apps' budgets explicitly.
DEFAULT_APP_BUDGET=100.00

# Unified OpenAI-compatible ingress. The AI Portal's Main Ingress card
# reads this path from /auth/config; it must match GATEWAY_UNIFIED_ROUTER_PATH on
# the edge, which is where the traffic is actually served.
UNIFIED_ROUTER_PATH=/v1

# Help links in the admin UI ("Documentation" button, /auth/features docs_url).
# GET /auth/features reports this value as features.docs_url.
DOCS_URL_OVERRIDE=https://tyk.io/docs/ai-management/ai-studio/overview

# Display URLs rendered in the admin UI. They point at the MICROGATEWAY, because
# that is where the data plane lives - /v1/..., /router/{slug}/...,
# /llm/call/{slug}/... and tool endpoints are all served by mgw.
PROXY_URL=http://localhost:__AISTUDIO_ROUTER_PORT__
TOOL_DISPLAY_URL=http://localhost:__AISTUDIO_ROUTER_PORT__
DATASOURCE_DISPLAY_URL=http://localhost:__AISTUDIO_ROUTER_PORT__

TIB_ENABLED=true

# Plugin marketplace index cache. The default ./.marketplace-cache resolves to
# /opt/tyk-ai-studio/.marketplace-cache, which the distroless image cannot write
# (the startup path report logs it as a problem); keep it under ./data.
MARKETPLACE_CACHE_DIR=./data/marketplace-cache

# Enterprise audit trail (on by default). Stated explicitly so the talk
# track can point at it: every POST/PUT/PATCH/DELETE on the management API,
# logins and logouts, with field-level diffs and secrets redacted.
AUDIT_ENABLED=true
AUDIT_STORE_TYPE=db
AUDIT_RETENTION_DAYS=90

# OCI plugin cache. Relative paths resolve under the image WORKDIR
# (/opt/tyk-ai-studio/), which is why the compose file mounts ./data/appdata and
# the signing key there.
AI_STUDIO_OCI_CACHE_DIR=./data/cache/plugins
AI_STUDIO_OCI_REQUIRE_SIGNATURE=true
AI_STUDIO_OCI_ALLOWED_REGISTRIES=docker.tyk.io
OCI_PLUGINS_PUBKEY_FILE_LIVE=./keys/plugins/plugin-live.pub
AI_STUDIO_OCI_TIMEOUT=30s
AI_STUDIO_OCI_RETRY_ATTEMPTS=3
AI_STUDIO_OCI_GC_INTERVAL=24h
AI_STUDIO_OCI_KEEP_VERSIONS=3

# Calls to internal addresses (loopback, private ranges) are blocked by default.
# The stub LLM backends live on the private compose network, so they are named
# here; everything else stays blocked. Point the LLMs at other in-network hosts
# and add them (comma-separated). The Tyk Dashboard connection is allowed through
# its own allow_internal_host flag (proofs/tyk-mcp-import.sh sets it).
LLM_UPSTREAM_ALLOWED_INTERNAL_HOSTS=llm-alpha,llm-beta

# Hub-and-spoke: this node is the control hub the edge microgateway registers
# with over gRPC. Configuration is pushed to the edge over this channel.
GATEWAY_MODE=control
GRPC_PORT=9080
GRPC_HOST=0.0.0.0
# DEVELOPMENT ONLY - plaintext gRPC on a private compose network.
GRPC_TLS_INSECURE=true
