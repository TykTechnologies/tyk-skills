# Tyk AI Studio edge microgateway (mgw), Enterprise edition (AI Studio 2.3).
#
# This is the DATA PLANE. Every runtime call is served here, not by the control
# plane: the unified OpenAI-compatible ingress (POST /v1/chat/completions with
# model "{llm-or-router-slug}/{model}", GET /v1/models), the Model Router alias
# POST /router/{slug}/v1/chat/completions, /ai/{slug}/... and /llm/call/{slug}/...
#
# Shared secrets (EDGE_AUTH_TOKEN, ENCRYPTION_KEY, JWT_SECRET, METRICS_AUTH_TOKEN)
# deliberately live in ../secret.env. Do not set them here: later env_file
# entries win, so a value here would override the minted one and the edge would
# never register.

# Container-internal listener. The host port is mapped in compose.yaml.
PORT=9091
HOST=0.0.0.0
TLS_ENABLED=false
READ_TIMEOUT=300s
WRITE_TIMEOUT=300s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=30s

# Edge-local SQLite cache of the configuration pushed down from the control plane.
DATABASE_TYPE=sqlite
# The directory must be writable by the container user (uid 65532) for the
# database and its -wal/-shm files; start.sh makes ./data/mgw writable.
DATABASE_DSN=file:/app/data/edge-ent.db?mode=rwc
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_AUTO_MIGRATE=true
DB_LOG_LEVEL=warn

CACHE_ENABLED=true
CACHE_MAX_SIZE=1000
CACHE_TTL=1h
CACHE_CLEANUP_INTERVAL=10m
CACHE_PERSIST_TO_DB=false

GATEWAY_TIMEOUT=30s
GATEWAY_MAX_REQUEST_SIZE=10485760
GATEWAY_MAX_RESPONSE_SIZE=52428800
GATEWAY_ENABLE_FILTERS=true
GATEWAY_ENABLE_ANALYTICS=true
# Unified OpenAI-compatible ingress. It must
# agree with UNIFIED_ROUTER_PATH on the control plane, which the AI Portal
# advertises on the App page's Main Ingress card.
GATEWAY_UNIFIED_ROUTER_PATH=/v1
GATEWAY_UNIFIED_ROUTER_DISABLED=false

ANALYTICS_ENABLED=true
ANALYTICS_BUFFER_SIZE=1000
ANALYTICS_FLUSH_INTERVAL=10s
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_REALTIME=false
ANALYTICS_STORE_REQUESTS=false
ANALYTICS_STORE_RESPONSES=false
ANALYTICS_MAX_BODY_SIZE=4096

BCRYPT_COST=10
TOKEN_LENGTH=32
SESSION_TIMEOUT=24h
ENABLE_IP_WHITELIST=false

LOG_LEVEL=info
LOG_FORMAT=text
# Prometheus on the edge. METRICS_AUTH_TOKEN (minted into ../secret.env, shared
# with the control plane) protects /metrics: a scrape needs
# Authorization: Bearer <token>, and no token or a wrong one answers 401.
ENABLE_METRICS=true
METRICS_PATH=/metrics
ENABLE_TRACING=false
ENABLE_PROFILING=false

# Hub-and-spoke: EDGE mode. CONTROL_ENDPOINT is the control plane's gRPC
# listener on the compose network, not its HTTP admin port.
GATEWAY_MODE=edge
CONTROL_ENDPOINT=ai-studio:9080
EDGE_ID=__SLUG__-edge-01
EDGE_NAMESPACE=default
EDGE_RECONNECT_INTERVAL=5s
EDGE_HEARTBEAT_INTERVAL=30s
EDGE_SYNC_TIMEOUT=10s

# DEVELOPMENT ONLY - plaintext gRPC on a private compose network.
EDGE_TLS_ENABLED=false
EDGE_SKIP_TLS_VERIFY=false
EDGE_ALLOW_INSECURE=true

EDGE_TOKEN_CACHE_ENABLED=true
EDGE_TOKEN_CACHE_TTL=5m
EDGE_TOKEN_CACHE_MAX_SIZE=1000
EDGE_TOKEN_CACHE_CLEANUP_INTERVAL=1m

# Calls to internal addresses are blocked by default on the edge too (each
# process applies its own setting). Name the in-network stub backends only.
LLM_UPSTREAM_ALLOWED_INTERNAL_HOSTS=llm-alpha,llm-beta

OCI_PLUGINS_CACHE_DIR=/data/cache/plugins
OCI_PLUGINS_MAX_CACHE_SIZE=1073741824
OCI_PLUGINS_REQUIRE_SIGNATURE=true
OCI_PLUGINS_ALLOWED_REGISTRIES=docker.tyk.io
OCI_PLUGINS_TIMEOUT=30s
OCI_PLUGINS_RETRY_ATTEMPTS=3
OCI_PLUGINS_GC_INTERVAL=24h
OCI_PLUGINS_KEEP_VERSIONS=3

# Analytics pulse: ships edge analytics, proxy logs, spend and compliance events
# (guardrail hits) to the control plane every 10 s. The image already defaults
# PLUGINS_CONFIG_PATH to its own
# /opt/tyk-microgateway/config/analytics-pulse-config.yaml; the bundle points at
# its mounted copy (compose.yaml) so the interval is visible and editable.
# Without the pulse the hub never sees edge spend or compliance events, and
# AISTUDIO-GUARDRAIL-001 cannot find its event.
PLUGINS_CONFIG_PATH=/opt/tyk-microgateway/mgw-analytics.yaml
MICROGATEWAY_ALLOW_ALL_PLUGIN_PATHS=1
