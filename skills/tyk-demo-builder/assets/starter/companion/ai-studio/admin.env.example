# Tyk AI Studio companion stack - host-only admin login.
#
# THIS EXAMPLE IS COMMITTED and ships with the password empty. The generator
# copies it to ./admin.env with a minted password; ./admin.env is the private
# copy: gitignored and mode 0600.
#
# Only the host scripts read ./admin.env (start.sh, configure-ai-studio.sh,
# verify-ai-studio.sh, lib/admin.sh and proofs/*.sh), and they source it without
# exporting it. It is deliberately NOT an env_file of either container, unlike
# ./secret.env, so the admin password never appears in a container's environment
# or in `docker inspect`. Keep it out of secret.env.
#
# First-run admin. The first user registered against an empty database is the
# administrator. The generator mints a password with an uppercase letter, a
# lowercase letter, a digit and a symbol. The name shown in the admin UI, the
# audit trail and every screenshot is "__DISPLAY_NAME__ Administrator".
AISTUDIO_ADMIN_EMAIL=admin@__SLUG__.invalid
AISTUDIO_ADMIN_PASSWORD=
