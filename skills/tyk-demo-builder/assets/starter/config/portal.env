PORTAL_LICENSEKEY=${TYK_PORTAL_LICENSE}
PORTAL_HOSTPORT=3001
PORTAL_THEMING_THEME=default
PORTAL_THEMING_DISABLE_UPLOAD=false
PORTAL_DISABLECSRFCHECK=true
PORTAL_DATABASE_DIALECT=postgres
PORTAL_DATABASE_CONNECTIONSTRING=host=tyk-postgres port=5432 dbname=portal user=tykuser password=${POSTGRES_PASSWORD} sslmode=disable
PORTAL_STORAGE=db
PORTAL_LOGFORMAT=dev
PORTAL_LOGLEVEL=info
PORTAL_AUDIT_LOG_ENABLE=true
PORTAL_AUDIT_LOG_PATH=/tmp
