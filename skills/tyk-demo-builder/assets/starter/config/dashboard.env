TYK_DB_LICENSEKEY=${TYK_LICENSE_KEY}
TYK_DB_LISTENPORT=3000
TYK_DB_ADMINSECRET=${ADMIN_SECRET}
TYK_DB_NODESECRET=${NODE_SECRET}
TYK_DB_TYKAPI_HOST=http://tyk-gateway
TYK_DB_TYKAPI_PORT=8080
TYK_DB_TYKAPI_SECRET=${NODE_SECRET}
TYK_DB_REDISADDRS=tyk-redis:6379
TYK_DB_STORAGE_MAIN_TYPE=postgres
TYK_DB_STORAGE_MAIN_CONNECTIONSTRING=user=tykuser password=${POSTGRES_PASSWORD} host=tyk-postgres port=5432 database=tyk_dashboard sslmode=disable
TYK_DB_STORAGE_ANALYTICS_TYPE=postgres
TYK_DB_STORAGE_ANALYTICS_CONNECTIONSTRING=user=tykuser password=${POSTGRES_PASSWORD} host=tyk-postgres port=5432 database=tyk_analytics sslmode=disable
# The Dashboard picks the scheme for every API URL it displays from this flag
# alone — it never inspects how the gateway actually listens, so it must be set
# to match the listener the generator chose. Wrong either way it shows an
# unusable address: http:// against a TLS listener, https:// against a plain one.
# It also drives the protocol written into a regenerated OAS `servers` entry, so
# it puts the same scheme into exported definitions.
#
# The generator sets this from the module set: false unless a selected module
# needs a TLS listener (today only mtls). See references/standalone-runtime.md.
#
# Named for the Go field (GenerateHTTPS), not the JSON key
# (generate_secure_paths) — the Dashboard maps env vars from field names, the
# same reason TYK_DB_TYKAPI_HOST sets tyk_api_config.Host. The JSON spelling is
# accepted silently and does nothing. The entry is regenerated on write, not
# read, so existing APIs keep the old scheme until they are re-imported.
TYK_DB_HOSTCONFIG_GENERATEHTTPS=__GENERATE_HTTPS__

TYK_DB_ENABLEOWNERSHIP=true
TYK_DB_SHOWORGID=true
TYK_DB_SECURITY_ALLOWADMINRESETPASSWORD=true
TYK_DB_SECURITY_FORCEFIRSTLOGINPWRESET=false
TYK_DB_STREAMING_ENABLED=true
