TYK_GW_LISTENPORT=8080
TYK_GW_SECRET=${NODE_SECRET}
TYK_GW_NODESECRET=${NODE_SECRET}
TYK_GW_ALLOWINSECURECONFIGS=true
TYK_GW_ALLOWREMOTECONFIG=true
TYK_GW_STORAGE_TYPE=redis
TYK_GW_STORAGE_ADDRS=tyk-redis:6379
TYK_GW_USEDBAPPCONFIGS=true
TYK_GW_DBAPPCONFOPTIONS_CONNECTIONSTRING=http://tyk-dashboard:3000
TYK_GW_POLICIES_POLICYSOURCE=service
TYK_GW_POLICIES_POLICYCONNECTIONSTRING=http://tyk-dashboard:3000
TYK_GW_ENABLEANALYTICS=true
TYK_GW_USEREDISLOG=true
TYK_GW_ANALYTICSSTORAGE_TYPE=redis
TYK_GW_ANALYTICSSTORAGE_ADDRS=tyk-redis:6379
# Full request/response capture is switched on per API (server.detailedActivityLogs), never
# globally: recording detail copies each response body for the analytics record, so a
# gateway-wide switch would also buffer streamed and large downloads. An API that streams
# leaves detailedActivityLogs off.
TYK_GW_ANALYTICSCONFIG_ENABLEDETAILEDRECORDING=false
TYK_GW_HTTPSERVEROPTIONS_ENABLEWEBSOCKETS=__ENABLE_WEBSOCKETS__
# JavaScript plugins (js-plugin module). The engine is chosen per API by
# pluginConfig.driver ("javascript" for goja on 5.15+, "otto" before); the VM
# itself is switched on here, for every gateway that reads this file.
TYK_GW_ENABLEJSVM=__ENABLE_JSVM__
# Per-API custom domains (custom-domain module), for every gateway.
TYK_GW_ENABLECUSTOMDOMAINS=__ENABLE_CUSTOM_DOMAINS__
TYK_GW_STREAMING_ENABLED=__ENABLE_STREAMS__
TYK_GW_LOGLEVEL=info
