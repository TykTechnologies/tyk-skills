# Tyk AI Studio control plane (hub). Secrets are in secret.env.

# The first account registered on an empty database becomes the admin, and
# registration must be open for that. Later sign-ups are ordinary users. Set
# this to false and recreate the container once the admin exists.
ALLOW_REGISTRATIONS=true
FROM_EMAIL=noreply@example.com
LOG_LEVEL=info

# SQLite keeps the evaluation small. compose.postgres.yaml switches to PostgreSQL.
DATABASE_TYPE=sqlite
DATABASE_URL=file:/data/studio.db

# Writable paths (the image's working directory is read-only for its user).
EXPORT_STORAGE_PATH=/data/exports
BRANDING_STORAGE_PATH=/data/branding
MARKETPLACE_CACHE_DIR=/data/marketplace-cache

# Hub and edge: this instance is the control plane edges register with.
GATEWAY_MODE=control
GRPC_HOST=0.0.0.0
GRPC_PORT=9080
# Plain-text gRPC on a private Compose network. Never outside a workstation.
GRPC_TLS_INSECURE=true

# Calls to internal addresses (private, loopback) are blocked by default. Allow
# only the two stand-in backends by name.
LLM_UPSTREAM_ALLOWED_INTERNAL_HOSTS=llm-alpha,llm-beta

# Help links in the admin UI.
DOCS_URL_OVERRIDE=https://tyk.io/docs/ai-management/ai-studio/overview

# No usage telemetry and no plugin marketplace sync from an evaluation stack.
TELEMETRY_ENABLED=false
LICENSE_DISABLE_TELEMETRY=true
MARKETPLACE_ENABLED=false
