# Tyk AI Studio edge gateway (microgateway). Secrets are in secret.env.
PORT=9091
HOST=0.0.0.0
LOG_LEVEL=info

# The edge keeps the configuration it receives from the hub in local SQLite.
DATABASE_TYPE=sqlite
DATABASE_DSN=file:/data/edge.db?mode=rwc
OCI_PLUGINS_CACHE_DIR=/data/plugins

# Hub and edge: register with the control plane's gRPC port.
GATEWAY_MODE=edge
CONTROL_ENDPOINT=studio:9080
EDGE_ID=edge-01
EDGE_NAMESPACE=default
# Plain-text gRPC on a private Compose network. Never outside a workstation.
EDGE_TLS_ENABLED=false
EDGE_ALLOW_INSECURE=true

# Calls to internal addresses (private, loopback) are blocked by default. Allow
# only the two stand-in backends by name.
LLM_UPSTREAM_ALLOWED_INTERNAL_HOSTS=llm-alpha,llm-beta

# Prometheus metrics need METRICS_AUTH_TOKEN (secret.env).
ENABLE_METRICS=true
