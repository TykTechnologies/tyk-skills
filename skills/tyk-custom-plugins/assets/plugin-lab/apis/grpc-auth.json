{
  "openapi": "3.0.3",
  "info": {
    "title": "grpc-auth",
    "version": "1.0.0"
  },
  "paths": {},
  "x-tyk-api-gateway": {
    "info": {
      "id": "grpc-auth",
      "orgId": "default",
      "name": "grpc-auth",
      "state": {
        "active": true
      }
    },
    "upstream": {
      "url": "http://upstream:8080"
    },
    "server": {
      "listenPath": {
        "value": "/grpc-auth/",
        "strip": true
      },
      "authentication": {
        "enabled": true,
        "custom": {
          "enabled": true,
          "config": {
            "enabled": true,
            "functionName": "GrpcAuth"
          }
        }
      }
    },
    "middleware": {
      "global": {
        "pluginConfig": {
          "driver": "grpc"
        },
        "postPlugins": [
          {
            "enabled": true,
            "functionName": "GrpcPost",
            "requireSession": true
          }
        ]
      }
    }
  }
}
