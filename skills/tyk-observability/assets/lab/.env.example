# Generate .env from this file (references/lab-and-grafana.md); Compose refuses to start while
# SECRET or GRAFANA_ADMIN_PASSWORD is empty. Never commit .env.
SECRET=
GRAFANA_ADMIN_PASSWORD=
# Host ports (127.0.0.1 only)
GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
GRAFANA_PORT=3000
ES_PORT=9200
# Custom metric instruments: create gateway-metrics.env with one line,
#   TYK_GW_OPENTELEMETRY_METRICS_APIMETRICS=<the JSON list on one line>
# The list replaces the four default instruments.
